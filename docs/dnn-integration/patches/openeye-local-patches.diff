+// local patch: force internal parameter defaults (repo ships no parameters.vh).
+// Guard sits at the head of this module file so it is compile-order independent.
+`ifndef USE_INTERNAL_PARAMS
+`define USE_INTERNAL_PARAMS
+`endif
 module OpenEye_FPGA #(
     //Set parameters
   `ifdef USE_INTERNAL_PARAMS
@@ -1210,7 +1215,11 @@ reg [1023:0] fst_path;
